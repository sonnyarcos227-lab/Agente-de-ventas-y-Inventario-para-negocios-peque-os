# ── LLM ── groq | ollama | auto (Groq y si falla Ollama)
LLM_PROVIDER=auto
# Copia aquí la misma clave de Archivo Vivo (Chatpdf\backend\.env) o saca una gratis en https://console.groq.com
GROQ_API_KEY=gsk_YOUR_KEY_HERE
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Respaldo local sin internet (ollama pull qwen2.5:7b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── PostgreSQL (contenedor pgvector de Docker) ──
DECORER_HOST=localhost:5432

# ── Embeddings: EmbeddingGemma 2 en llama.cpp ──
LLAMACPP_EMBED_URL=http://127.0.0.1:8081

# ── Panel del dueño ──
CLAVE_DUENO=decorer2026

# gpt-oss razona antes de responder: low = rápido (recomendado para vender), medium o high = más lento
REASONING_EFFORT=low

# ── Voz ──
# STT: local = faster-whisper en el PC (gratis, sin internet) | groq = Whisper en la nube | auto = local y si falla Groq
STT_BACKEND=auto
STT_MODELO=small
# TTS: voz de Piper (run_backend.bat la descarga la primera vez)
VOZ_PIPER=es_MX-claude-high
VOZ_VELOCIDAD=1.0

# ── Visión: leer facturas de proveedor (ollama pull qwen2.5vl:3b) ──
OLLAMA_VISION_MODEL=qwen2.5vl:3b
VISION_TIMEOUT=300
